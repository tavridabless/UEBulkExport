<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- The current resolver can omit a dependency when overriding an exact upstream version. -->
    <RestoreUseLegacyDependencyResolver>true</RestoreUseLegacyDependencyResolver>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageVersion Include="CUE4Parse" Version="1.2.2.202609" />
    <PackageVersion Include="CUE4Parse-Conversion" Version="1.2.2.202609" />
    <!-- The transitive minimum (9.0.0) carries advisory GHSA-73j8-2gch-69rq. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- CUE4Parse-Conversion uses ImageSharp. Pin its patched v3 release. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Older dependency ranges still surface in the legacy resolver, including Windows publish. -->
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Fluent controls read their colours from well-known resource keys. Pointing those keys at the
    glass brushes restyles every TextBox, ComboBox, Button and Expander at once, without copying
    control templates.
  -->
  <Styles.Resources>
    <StaticResource x:Key="ButtonBackground" ResourceKey="Brush.Field" />
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="Brush.FieldHover" />
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="Brush.Selection" />
    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Brush.FieldBorder" />
    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="Brush.FieldBorder" />
    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="Brush.FieldBorder" />
    <StaticResource x:Key="ButtonForeground" ResourceKey="Brush.Text" />
    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Brush.Text" />
    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="Brush.Text" />

    <StaticResource x:Key="TextControlBackground" ResourceKey="Brush.Field" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Brush.FieldHover" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Brush.FieldHover" />
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Brush.FieldBorder" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Brush.FieldBorder" />

    <StaticResource x:Key="ComboBoxBackground" ResourceKey="Brush.Field" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="Brush.FieldHover" />
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="Brush.Selection" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="Brush.FieldBorder" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="Brush.FieldBorder" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="Brush.SurfaceSolid" />

    <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="Brush.Card" />
    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="Brush.FieldHover" />
    <StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="Brush.Selection" />
    <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="Brush.CardBorder" />
    <StaticResource x:Key="ExpanderHeaderBorderBrushPointerOver" ResourceKey="Brush.CardBorder" />
    <StaticResource x:Key="ExpanderContentBackground" ResourceKey="Brush.Card" />
    <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="Brush.CardBorder" />

    <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="Brush.AccentSoft" />
    <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="Brush.AccentSoft" />
    <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="Brush.Selection" />
    <StaticResource x:Key="TreeViewItemForegroundSelected" ResourceKey="Brush.Text" />
    <StaticResource x:Key="TreeViewItemForegroundSelectedPointerOver" ResourceKey="Brush.Text" />

    <StaticResource x:Key="ToolTipBackground" ResourceKey="Brush.SurfaceSolid" />
    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="Brush.SurfaceSolid" />

    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
  </Styles.Resources>

  <!-- Typography -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource App.Font}" />
  </Style>
  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontFamily" Value="{DynamicResource App.FontDisplay}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.PageSubtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- Frosted cards -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="22,20" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Card}" />
  </Style>
  <Style Selector="TextBlock.CardTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.CardSubtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,12" />
  </Style>

  <!-- Form rows -->
  <Style Selector="TextBlock.Label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="0,10,0,5" />
  </Style>
  <Style Selector="TextBlock.Hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,5,0,0" />
  </Style>
  <Style Selector="TextBlock.Warning">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="TextBlock.Error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.Mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox.Mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Buttons: frosted by default, a luminous gradient for the one action that matters -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="22,9" />
  </Style>
  <Style Selector="Button.Primary /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Accent}" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Button.Primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Button.Danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
  </Style>
  <Style Selector="Button.Link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <!-- Quiet icon buttons in the title and tool bars -->
  <Style Selector="Button.Ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Navigation: transparent rail, a frosted fill and a short accent pill for the active page -->
  <Style Selector="ListBox.Nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.NavIndicator">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected Border.NavIndicator">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Path.NavIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected Path.NavIcon">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- Mode picker: a row of selectable glass tiles -->
  <Style Selector="ListBox.Modes">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem">
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FieldHover}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <!-- Plain data lists -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.Data ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.Data ListBoxItem:selected /template/ ContentPresenter,
                   ListBox.Rows ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Data ListBoxItem:pointerover /template/ ContentPresenter,
                   ListBox.Rows ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.Data ListBoxItem, ListBox.Rows ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentGradient}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    <Setter Property="Margin" Value="0,14" />
  </Style>

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Thin, unobtrusive scroll bars -->
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- Container browser: breadcrumb links, type filter pills, detail tags -->
  <Style Selector="Button.Crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.Crumb:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.Chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FieldHover}" />
  </Style>
  <Style Selector="Border.Tag">
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.Tag TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Page scaffolding -->
  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.PageSubtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,18" />
  </Style>
  <Style Selector="TextBlock.CardTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.CardSubtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,12" />
  </Style>

  <!-- Form rows -->
  <Style Selector="TextBlock.Label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>
  <Style Selector="TextBlock.Hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="TextBlock.Warning">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="TextBlock.Error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.Mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox.Mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="20,8" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.Primary:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.Danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
  </Style>
  <Style Selector="Button.Link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="ListBox.Nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Path.NavIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected Path.NavIcon">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- Mode picker: a horizontal row of selectable cards -->
  <Style Selector="ListBox.Modes">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Modes ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>

  <!-- Plain data lists -->
  <Style Selector="ListBox.Data ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Container browser: breadcrumb links, type chips, detail tags -->
  <Style Selector="Button.Crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.Crumb:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.Chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
  </Style>
  <Style Selector="ListBox.Chips ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="Border.Tag">
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.Tag TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

</Styles>

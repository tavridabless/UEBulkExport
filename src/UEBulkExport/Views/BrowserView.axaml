<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UEBulkExport.Gui.ViewModels"
             xmlns:loc="using:UEBulkExport.Gui.Localization"
             x:Class="UEBulkExport.Gui.Views.BrowserView"
             x:DataType="vm:BrowserViewModel">

  <UserControl.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="ListBox.Rows ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBox.Rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    </Style>
    <Style Selector="TextBlock.ExcludedRow">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,24,28,20">

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Classes="PageTitle" Text="{loc:Tr Browser.Title}" />
      <TextBlock Classes="PageSubtitle" Text="{loc:Tr Browser.Subtitle}" />
    </StackPanel>

    <!-- Empty state -->
    <Border Grid.Row="2" Classes="Card" IsVisible="{Binding !HasData}" VerticalAlignment="Top">
      <Panel>
        <TextBlock Text="{loc:Tr Browser.NotScanned}" IsVisible="{Binding !Export.ShowScanLine, FallbackValue=True}"
                   TextWrapping="Wrap" Classes="Muted" />
        <TextBlock Text="{Binding Export.ScanText}" IsVisible="{Binding Export.ShowScanLine, FallbackValue=False}"
                   TextWrapping="Wrap" Classes="Muted" />
      </Panel>
    </Border>

    <!-- Toolbar: path, search and scope -->
    <Border Grid.Row="1" Classes="Card" Padding="14,10" Margin="0,0,0,12" IsVisible="{Binding HasData}">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="14" RowSpacing="8">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderNode">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <TextBlock Text="›" Classes="Muted" VerticalAlignment="Center" Margin="4,0" />
                  <Button Classes="Crumb" Content="{Binding Name}"
                          Command="{Binding $parent[ItemsControl].((vm:BrowserViewModel)DataContext).NavigateToCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBox Grid.Column="1" Width="200" Text="{Binding Search}" Watermark="{loc:Tr Browser.Search.Placeholder}"
                 AutomationProperties.Name="{loc:Tr Browser.Search.Placeholder}" />

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
          <ComboBox Width="156" ItemsSource="{Binding Chips}" SelectedItem="{Binding Chip}" Margin="0,0,12,0"
                    AutomationProperties.Name="{loc:Tr Browser.Filter.Label}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterChip">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="{loc:Tr Browser.Search.Descendants}" IsChecked="{Binding IncludeSubfolders}"
                    Margin="0,0,14,0" ToolTip.Tip="{loc:Tr Browser.Search.Descendants.Hint}" />
          <TextBlock Text="{Binding MatchesSummary}" Classes="Muted" FontSize="12" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LockedContainersSummary}" Classes="Warning" TextWrapping="Wrap"
                   IsVisible="{Binding LockedContainersSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </Border>

    <Grid x:Name="BrowserPanes" Grid.Row="2" ColumnDefinitions="160,10,*,10,190" IsVisible="{Binding HasData}">

      <!-- Folder tree -->
      <Border Grid.Column="0" Classes="Card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Classes="CardTitle" FontSize="13" Text="{loc:Tr Browser.Folders}" Margin="16,12,16,6" />
          <TreeView Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedFolder}" Margin="4,0,4,8"
                    AutomationProperties.Name="{loc:Tr Browser.Folders}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FolderNode">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="M3 6 A2 2 0 0 1 5 4 L9 4 L11 6 L19 6 A2 2 0 0 1 21 8 L21 18 A2 2 0 0 1 19 20 L5 20 A2 2 0 0 1 3 18 Z"
                            Width="13" Height="13" Foreground="{DynamicResource Brush.Accent}" />
                  <TextBlock Text="{Binding Name}" FontSize="13" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <!-- Rows -->
      <Border Grid.Column="2" Classes="Card" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="34,22,*,60,90" Margin="18,12,18,6">
            <Button Grid.Column="2" Classes="Crumb" Padding="0" MinHeight="0" Content="{Binding NameSortHeader}" FontSize="11"
                    HorizontalAlignment="Left" Command="{Binding SortByNameCommand}" ToolTip.Tip="{loc:Tr Browser.Sort.Hint}" />
            <Button Grid.Column="3" Classes="Crumb" Padding="0" MinHeight="0" Content="{Binding TypeSortHeader}" FontSize="11"
                    HorizontalAlignment="Left" Command="{Binding SortByTypeCommand}" ToolTip.Tip="{loc:Tr Browser.Sort.Hint}" />
            <Button Grid.Column="4" Classes="Crumb" Padding="0" MinHeight="0" Content="{Binding SizeSortHeader}" FontSize="11"
                    HorizontalAlignment="Right" Command="{Binding SortBySizeCommand}" ToolTip.Tip="{loc:Tr Browser.Sort.Hint}" />
          </Grid>

          <ListBox Grid.Row="1" Classes="Rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding FocusedRow}"
                   Margin="8,0,8,8" Background="Transparent" DoubleTapped="OnRowDoubleTapped" KeyDown="OnRowKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BrowserRow">
                <Grid ColumnDefinitions="34,22,*,60,90">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" MinWidth="0" Padding="0" Margin="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                  <PathIcon Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Accent}" IsVisible="{Binding IsFolder}"
                            Data="M3 6 A2 2 0 0 1 5 4 L9 4 L11 6 L19 6 A2 2 0 0 1 21 8 L21 18 A2 2 0 0 1 19 20 L5 20 A2 2 0 0 1 3 18 Z" />
                  <PathIcon Grid.Column="1" Width="13" Height="13" VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding !IsFolder}"
                            Data="M6 3 L14 3 L19 8 L19 21 L6 21 Z M14 3 L14 8 L19 8" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"
                             Classes.ExcludedRow="{Binding IsExcluded}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding TypeText}" FontSize="12" Classes="Muted Mono" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="12" Classes="Muted" VerticalAlignment="Center"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SizeText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Text="{loc:Tr Browser.Empty}" Classes="Muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !Rows.Count}" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="18,8,18,12">
            <TextBlock Text="{Binding PagingSummary}" Classes="Muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Padding="8,6" Content="{loc:Tr Browser.Paging.Previous}" Command="{Binding PreviousPageCommand}" />
            <Button Grid.Column="2" Padding="8,6" Content="{loc:Tr Browser.Paging.Next}" Command="{Binding NextPageCommand}" />
          </Grid>
        </Grid>
      </Border>

      <!-- Details -->
      <Border x:Name="DetailsCard" Grid.Column="4" Classes="Card" Padding="18,16">
        <Grid>
          <TextBlock Text="{loc:Tr Browser.Details.Empty}" Classes="Muted" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" IsVisible="{Binding !HasDetail}" />

          <ScrollViewer IsVisible="{Binding HasDetail}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding DetailName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailKind}" Classes="Muted" FontSize="12" />
              <Button Content="{loc:Tr Common.OpenFolder}" IsVisible="{Binding DetailIsFolder}"
                      Command="{Binding OpenRowCommand}" CommandParameter="{Binding FocusedRow}" />

              <WrapPanel>
                <Border Classes="Tag" IsVisible="{Binding DetailHasExtension}"><TextBlock Text="{Binding DetailExtension}" /></Border>
                <Border Classes="Tag"><TextBlock Text="{Binding DetailSize}" /></Border>
                <Border Classes="Tag"><TextBlock Text="{Binding DetailEngine}" /></Border>
              </WrapPanel>

              <TextBlock Classes="Label" Text="{loc:Tr Browser.Details.Path}" Margin="0,6,0,4" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding DetailPath}" IsReadOnly="True" Classes="Mono"
                         AutomationProperties.Name="{loc:Tr Browser.Details.Path}" />
                <Button Grid.Column="1" Padding="8" MinHeight="0" ToolTip.Tip="{loc:Tr Common.Copy}"
                        AutomationProperties.Name="{loc:Tr Common.Copy}" Click="OnCopyPath">
                  <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round"
                        Stroke="{DynamicResource Brush.Text}"
                        Data="M9 9 L9 5 A1 1 0 0 1 10 4 L19 4 A1 1 0 0 1 20 5 L20 14 A1 1 0 0 1 19 15 L15 15 M5 9 L14 9 A1 1 0 0 1 15 10 L15 19 A1 1 0 0 1 14 20 L5 20 A1 1 0 0 1 4 19 L4 10 A1 1 0 0 1 5 9 Z" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding ClipboardStatus}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />

              <TextBlock Classes="Label" Text="{loc:Tr Browser.Details.Container}" Margin="0,4,0,4" />
              <TextBox Text="{Binding DetailContainer}" IsReadOnly="True"
                       AutomationProperties.Name="{loc:Tr Browser.Details.Container}" />

              <TextBlock Classes="Label" Text="{loc:Tr Browser.Details.Output}" Margin="0,4,0,4" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding Export.OutputPath}" Watermark="{loc:Tr Export.Out.Placeholder}"
                         AutomationProperties.Name="{loc:Tr Browser.Details.Output}" />
                <Button Grid.Column="1" Padding="8" MinHeight="0" Command="{Binding BrowseOutputCommand}"
                        ToolTip.Tip="{loc:Tr Common.BrowseFolder}" AutomationProperties.Name="{loc:Tr Common.BrowseFolder}">
                  <PathIcon Width="13" Height="13" Data="M3 6 A2 2 0 0 1 5 4 L9 4 L11 6 L19 6 A2 2 0 0 1 21 8 L21 18 A2 2 0 0 1 19 20 L5 20 A2 2 0 0 1 3 18 Z" />
                </Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Action bar -->
    <Border Grid.Row="3" Classes="Card" Padding="16,12" Margin="0,12,0,0" IsVisible="{Binding HasData}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="{Binding SelectedSubText}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding VisibleSelectionSummary}" Classes="Muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding HasSelection}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:Tr Browser.Selection.Actions}" VerticalAlignment="Center">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Tr Browser.SelectAll}" Command="{Binding SelectAllShownCommand}" />
              <MenuItem Header="{loc:Tr Browser.SelectMatches}" Command="{Binding SelectAllMatchesCommand}"
                        ToolTip.Tip="{loc:Tr Browser.SelectMatches.Hint}" />
              <MenuItem Header="{loc:Tr Browser.ClearSelection}" Command="{Binding ClearSelectionCommand}"
                        IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="{loc:Tr Browser.Exclude}" Command="{Binding ExcludeCheckedCommand}"
                        AutomationProperties.AutomationId="ExcludeButton" ToolTip.Tip="{loc:Tr Browser.Exclude.Hint}"
                        IsEnabled="{Binding HasSelection}" />
              <Separator />
              <MenuItem Header="{Binding ExportButtonText}" Command="{Binding ExportSelectedCommand}"
                        AutomationProperties.AutomationId="ExportSelectedButton" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="ReviewBrowserExportButton"
                Classes="Primary" Content="{loc:Tr Browser.ReviewExport}" Command="{Binding ReviewExportCommand}"
                ToolTip.Tip="{loc:Tr Browser.ReviewExport.Hint}" AutomationProperties.HelpText="{loc:Tr Browser.ReviewExport.Hint}" />
      </Grid>
    </Border>
  </Grid>

</UserControl>

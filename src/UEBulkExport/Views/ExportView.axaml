<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UEBulkExport.Gui.ViewModels"
             xmlns:loc="using:UEBulkExport.Gui.Localization"
             xmlns:svc="using:UEBulkExport.Gui.Services"
             x:Class="UEBulkExport.Gui.Views.ExportView"
             x:DataType="vm:ExportViewModel">

  <!--
    Only three decisions are on the surface: the source, the result and the destination. What the
    program can work out itself (engine version, encryption, mappings) is shown as a finding, and
    everything else waits in collapsed sections that state what they are set to.
  -->
  <Grid RowDefinitions="*,Auto">

    <!-- The page is as wide as the viewport, never wider: long paths clip instead of
         pushing the layout past the window edge. -->
    <ScrollViewer Grid.Row="0">
      <Grid Width="{Binding $parent[ScrollViewer].Viewport.Width}">
      <StackPanel Margin="28,24,28,16" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">

        <TextBlock Classes="PageTitle" Text="{loc:Tr Export.Title}" Margin="0,0,0,4" />

        <!-- Recent games -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding HasRecent}">
        <TextBlock Grid.Column="0" Classes="Muted" FontSize="13" Text="{loc:Tr Recent.Title}" Margin="0,8,0,0"
                   VerticalAlignment="Top" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Recent}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:RecentGame">
              <Border CornerRadius="8" Background="{DynamicResource Brush.Card}"
                      BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                      Margin="0,0,8,8" Padding="0">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Grid.Column="0" Background="Transparent" Padding="12,7" MinHeight="0"
                          ToolTip.Tip="{Binding PaksPath}"
                          Command="{Binding $parent[ItemsControl].((vm:ExportViewModel)DataContext).ApplyRecentCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                  </Button>
                  <Button Grid.Column="1" Background="Transparent" Padding="8" MinHeight="0"
                          VerticalAlignment="Center" ToolTip.Tip="{loc:Tr Recent.Remove}"
                          Command="{Binding $parent[ItemsControl].((vm:ExportViewModel)DataContext).RemoveRecentCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="M6 6 L18 18 M18 6 L6 18" Width="9" Height="9" Stretch="Uniform"
                          Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.6" StrokeLineCap="Round" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>

        <!-- Selection made in the Browser -->
        <Border Classes="Card" IsVisible="{Binding HasSelection}" Padding="20,14" BorderBrush="{DynamicResource Brush.Accent}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="CardTitle" Text="{loc:Tr Export.Selection.Title}" FontSize="14" />
              <TextBlock Classes="Hint" Text="{Binding SelectionText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Tr Export.Selection.Clear}" Command="{Binding ClearSelectionCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Source -->
        <Border Classes="Card">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <TextBlock Classes="CardTitle" Text="{loc:Tr Export.Source.Title}" />
              <Border Classes="Help" ToolTip.Tip="{loc:Tr Export.Source.Help}"><TextBlock /></Border>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" AutomationProperties.AutomationId="PaksPath" Text="{Binding PaksPath}"
                       Watermark="{loc:Tr Export.Paks.Placeholder}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFolder}" Command="{Binding BrowsePaksFolderCommand}" />
              <Button Grid.Column="2" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowsePaksFileCommand}" />
            </Grid>

            <!-- What the program found -->
            <StackPanel Spacing="6" Margin="2,12,0,0" IsVisible="{Binding HasSource}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding ShowScanLine}">
                <Panel Grid.Column="0" VerticalAlignment="Center">
                  <Ellipse Classes="Dot Error" IsVisible="{Binding ScanIsProblem}" />
                  <Ellipse Classes="Dot Warning" IsVisible="{Binding ScanIsWarning}" />
                  <Ellipse Classes="Dot" IsVisible="{Binding ScanIsNormal}" />
                </Panel>
                <Panel Grid.Column="1">
                  <TextBlock Classes="Status Error" Text="{Binding ScanText}" IsVisible="{Binding ScanIsProblem}" />
                  <TextBlock Classes="Status Warning" Text="{Binding ScanText}" IsVisible="{Binding ScanIsWarning}" />
                  <TextBlock Classes="Status" Text="{Binding ScanText}" IsVisible="{Binding ScanIsNormal}" />
                </Panel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                  <Button Classes="Link" Content="{loc:Tr Export.Aes.Add}" Command="{Binding AddAesKeyCommand}"
                          IsVisible="{Binding CanAddAesKey}" />
                  <Button Classes="Link" Content="{loc:Tr Export.Scan.Retry}" Command="{Binding RescanCommand}"
                          IsVisible="{Binding CanRescan}" ToolTip.Tip="{loc:Tr Export.Scan.Retry.Hint}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding ShowEngineLine}">
                <Panel Grid.Column="0" VerticalAlignment="Center">
                  <Ellipse Classes="Dot Warning" IsVisible="{Binding EngineNeedsAttention}" />
                  <Ellipse Classes="Dot" IsVisible="{Binding !EngineNeedsAttention}" />
                </Panel>
                <Panel Grid.Column="1">
                  <TextBlock Classes="Status Warning" Text="{Binding EngineText}" IsVisible="{Binding EngineNeedsAttention}" />
                  <TextBlock Classes="Status" Text="{Binding EngineText}" IsVisible="{Binding !EngineNeedsAttention}" />
                </Panel>
                <Button Grid.Column="2" Classes="Link" Content="{loc:Tr Export.Engine.Change}"
                        Command="{Binding ToggleEngineEditorCommand}" VerticalAlignment="Center"
                        IsVisible="{Binding !EngineNeedsAttention}" />
              </Grid>
            </StackPanel>

            <!-- Engine version: only when it could not be read, or on request -->
            <StackPanel IsVisible="{Binding ShowEngineSelector}" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="Label" Text="{loc:Tr Export.Game.Label}" />
                <Border Classes="Help" ToolTip.Tip="{loc:Tr Export.Game.Help}" Margin="0,5,0,0"><TextBlock /></Border>
              </StackPanel>
              <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MaxDropDownHeight="360"
                        MaxWidth="360" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- AES keys: only for an encrypted source, or on request -->
            <StackPanel IsVisible="{Binding ShowAes}" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="Label" Text="{loc:Tr Export.Aes.Label}" />
                <Border Classes="Help" ToolTip.Tip="{loc:Tr Export.Aes.Help}" Margin="0,5,0,0"><TextBlock /></Border>
              </StackPanel>
              <TextBlock Classes="Warning" Text="{Binding AesPrompt}" IsVisible="{Binding HasAesPrompt}" Margin="0,0,0,6" />
              <TextBox Classes="Mono" Text="{Binding AesText}" AcceptsReturn="True" MinHeight="64" MaxHeight="120"
                       Watermark="0x0123456789ABCDEF…" TextWrapping="NoWrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Result -->
        <Border Classes="Card">
          <StackPanel>
            <TextBlock Classes="CardTitle" Text="{loc:Tr Export.Mode.Title}" Margin="0,0,0,12" />
            <ListBox Classes="Modes" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" AutoScrollToSelectedItem="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModeOption">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6" ToolTip.Tip="{Binding Details}" ToolTip.ShowDelay="400"
                        Background="Transparent">
                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Classes="Muted" />
                    <TextBlock Grid.Row="2" Text="{Binding CliName}" Classes="Caption Muted" Margin="0,4,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Mappings: only for results that read properties -->
            <StackPanel IsVisible="{Binding NeedsMappings}" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="Label" Text="{loc:Tr Export.Usmap.Label}" Margin="0,0,0,5" />
                <Border Classes="Help" ToolTip.Tip="{loc:Tr Export.Usmap.Help}" Margin="0,0,0,5"><TextBlock /></Border>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding UsmapPath}" Watermark="{loc:Tr Common.Auto}" />
                <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseUsmapCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="2,8,0,0">
                <TextBlock Grid.Column="0" Classes="Status Warning" Text="{Binding MappingsText}" IsVisible="{Binding MappingsIsWarning}" />
                <TextBlock Grid.Column="0" Classes="Hint" Margin="0" Text="{Binding MappingsText}" IsVisible="{Binding MappingsIsNormal}" />
                <Button Grid.Column="1" Classes="Link" Content="{loc:Tr Export.Usmap.Guide}" Command="{Binding OpenMappingsGuideCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Destination -->
        <Border Classes="Card">
          <StackPanel>
            <TextBlock Classes="CardTitle" Text="{loc:Tr Export.Out.Title}" Margin="0,0,0,10" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" AutomationProperties.AutomationId="OutputPath" Text="{Binding OutputPath}"
                       Watermark="{loc:Tr Export.Out.Placeholder}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFolder}" Command="{Binding BrowseOutputCommand}" />
            </Grid>
            <TextBlock Classes="Hint" Text="{loc:Tr Export.Out.Hint}" IsVisible="{Binding !Overwrite}" />
            <TextBlock Classes="Warning" Text="{Binding OverwriteWarning}" IsVisible="{Binding Overwrite}" />
          </StackPanel>
        </Border>

        <!-- Export options -->
        <Expander>
          <Expander.Header>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="CardTitle" FontSize="15" Text="{loc:Tr Export.Options.Title}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="SectionState" Text="{Binding OptionsSummary}"
                         Classes.Changed="{Binding OptionsChanged}" HorizontalAlignment="Right" />
            </Grid>
          </Expander.Header>

          <StackPanel Margin="4,6,4,4">
            <TextBlock Classes="Label" Text="{loc:Tr Export.Threads}" Margin="0,0,0,4" />
            <Grid ColumnDefinitions="*,56" ColumnSpacing="12">
              <Slider Grid.Column="0" Minimum="1" Maximum="{Binding MaxThreads}" Value="{Binding Threads}"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Threads}" VerticalAlignment="Center" FontWeight="SemiBold"
                         HorizontalAlignment="Right" />
            </Grid>

            <Separator />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="CardTitle" Text="{loc:Tr Export.Filters.Title}" FontSize="14" />
              <Border Classes="Help" ToolTip.Tip="{loc:Tr Export.Filters.Hint}"><TextBlock /></Border>
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0">
                <TextBlock Classes="Label" Text="{loc:Tr Export.Include}" />
                <TextBox Classes="Mono" Text="{Binding IncludeRegex}" Watermark="^MyGame/Content/Characters/" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="Label" Text="{loc:Tr Export.Exclude}" />
                <TextBox Classes="Mono" Text="{Binding ExcludeRegex}" Watermark="^Engine/" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="Warning" Text="{loc:Tr Export.Filters.LegacyIoStore}" IsVisible="{Binding IsLegacyMode}" />

            <Separator />

            <TextBlock Classes="CardTitle" Text="{loc:Tr Export.What.Title}" FontSize="14" Margin="0,0,0,8" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="2">
                <CheckBox IsChecked="{Binding Overwrite}" Content="{loc:Tr Opt.Overwrite}" ToolTip.Tip="{loc:Tr Opt.Overwrite.Hint}" />
                <CheckBox IsChecked="{Binding Verbose}" Content="{loc:Tr Opt.Verbose}" />
                <CheckBox IsChecked="{Binding SkipWorlds}" Content="{loc:Tr Opt.NoWorlds}" ToolTip.Tip="{loc:Tr Opt.NoWorlds.Hint}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding ExportMaterials}" Content="{loc:Tr Opt.Materials}" ToolTip.Tip="{loc:Tr Opt.Materials.Hint}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding RawPackages}" Content="{loc:Tr Opt.RawPackages}" IsEnabled="{Binding NeedsMappings}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <CheckBox IsChecked="{Binding SkipJson}" Content="{loc:Tr Opt.NoJson}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding SkipAssets}" Content="{loc:Tr Opt.NoAssets}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding SkipRawMisc}" Content="{loc:Tr Opt.NoRawMisc}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding SkipAudioConvert}" Content="{loc:Tr Opt.NoAudioConvert}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding AllMips}" Content="{loc:Tr Opt.AllMips}" IsEnabled="{Binding IsFullMode}" />
                <CheckBox IsChecked="{Binding SkipMorphs}" Content="{loc:Tr Opt.NoMorphs}" IsEnabled="{Binding IsFullMode}" />
              </StackPanel>
            </Grid>

            <Separator />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
              <TextBlock Classes="CardTitle" Text="{loc:Tr Export.Formats.Title}" FontSize="14" />
              <Border Classes="Help" ToolTip.Tip="{loc:Tr Export.Formats.Hint}"><TextBlock /></Border>
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16"
                  IsEnabled="{Binding IsFullMode}">
              <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Mesh}" />
                <ComboBox ItemsSource="{Binding MeshFormats}" SelectedItem="{Binding MeshFormat}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Anim}" />
                <ComboBox ItemsSource="{Binding AnimFormats}" SelectedItem="{Binding AnimFormat}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Texture}" />
                <ComboBox ItemsSource="{Binding TextureFormats}" SelectedItem="{Binding TextureFormat}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Quality}" />
                <ComboBox ItemsSource="{Binding MeshQualities}" SelectedItem="{Binding MeshQuality}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Nanite}" />
                <ComboBox ItemsSource="{Binding NaniteFormats}" SelectedItem="{Binding NaniteFormat}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Sockets}" />
                <ComboBox ItemsSource="{Binding SocketFormats}" SelectedItem="{Binding SocketFormat}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Classes="Label" Text="{loc:Tr Fmt.Platform}" />
                <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Expander>

        <!-- Helper binaries -->
        <Expander>
          <Expander.Header>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="CardTitle" FontSize="15" Text="{loc:Tr Export.Tools.Title}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="SectionState" Text="{Binding ToolsSummary}" HorizontalAlignment="Right" />
            </Grid>
          </Expander.Header>
          <StackPanel Margin="4,6,4,4">
            <TextBlock Classes="Hint" Text="{loc:Tr Export.Tools.Hint}" Margin="0,0,0,4" />

            <TextBlock Classes="Label" Text="{loc:Tr Tools.Retoc}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding RetocPath}" Watermark="{loc:Tr Common.Auto}" ToolTip.Tip="{loc:Tr Tools.Retoc.Hint}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseRetocCommand}" />
            </Grid>

            <TextBlock Classes="Label" Text="{loc:Tr Tools.Oodle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding OodlePath}" Watermark="{loc:Tr Common.Auto}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseOodleCommand}" />
            </Grid>

            <TextBlock Classes="Label" Text="{loc:Tr Tools.Zlib}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ZlibPath}" Watermark="{loc:Tr Common.Auto}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseZlibCommand}" />
            </Grid>

            <TextBlock Classes="Label" Text="{loc:Tr Tools.Vgmstream}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding VgmStreamPath}" Watermark="{loc:Tr Common.Optional}" ToolTip.Tip="{loc:Tr Tools.Vgmstream.Hint}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseVgmStreamCommand}" />
            </Grid>
          </StackPanel>
        </Expander>

        <!-- Equivalent command line: for scripts, so out of the way -->
        <Expander>
          <Expander.Header>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="CardTitle" FontSize="15" Text="{loc:Tr Export.Command.Label}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="SectionState" Text="{loc:Tr Export.Command.Hint}" HorizontalAlignment="Right" />
            </Grid>
          </Expander.Header>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="4,6,4,4">
            <TextBox Grid.Column="0" Classes="Mono" Text="{Binding CommandLine}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="0" />
            <Button Grid.Column="1" Content="{loc:Tr Common.Copy}" Command="{Binding CopyCommandCommand}" VerticalAlignment="Top" />
          </Grid>
        </Expander>

        <!-- Outcome: error -->
        <Border x:Name="ErrorCard" Classes="Card" IsVisible="{Binding HasError}" BorderBrush="{DynamicResource Brush.Error}">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Error.Title}" Classes="Muted" FontSize="12" />
            <TextBlock Text="{Binding ErrorHeadline}" Classes="Error" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding ErrorHint}" Classes="Mono" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <!-- Outcome: summary / plan -->
        <Border x:Name="SummaryCard" Classes="Card" IsVisible="{Binding HasSummary}">
          <StackPanel>
            <TextBlock Classes="CardTitle" Text="{Binding SummaryTitle}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Summary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryLine">
                  <Grid ColumnDefinitions="260,*" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="Muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0" IsVisible="{Binding CanOpenOutput}">
              <Button Content="{loc:Tr Export.OpenOutput}" Command="{Binding OpenOutputCommand}" />
              <Button Content="{loc:Tr Export.OpenErrors}" Command="{Binding OpenErrorsCommand}" IsVisible="{Binding HasErrorsFile}" />
              <Button Content="{loc:Tr Export.OpenLog}" Command="{Binding OpenLogCommand}" IsVisible="{Binding CanOpenLog}" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Action bar: whether the export can start, and why not -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,1,0,0" Padding="28,14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center"
              IsVisible="{Binding ShowReadiness}">
          <Panel Grid.Column="0">
            <Ellipse Classes="Dot Error" IsVisible="{Binding IsReadinessBlocked}" />
            <Ellipse Classes="Dot Warning" IsVisible="{Binding IsReadinessWarning}" />
            <Ellipse Classes="Dot" IsVisible="{Binding IsReadinessOk}" />
          </Panel>
          <TextBlock Grid.Column="1" Classes="Status" Text="{Binding ReadinessText}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadinessText}" />
        </Grid>

        <Grid Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center" IsVisible="{Binding ShowProgress}"
              RowDefinitions="Auto,Auto" RowSpacing="6">
          <ProgressBar Grid.Row="0" Value="{Binding ProgressFraction}" Maximum="1"
                       IsIndeterminate="{Binding ProgressIndeterminate}" />
          <WrapPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Progress.Processed}" Classes="Muted" FontSize="12" />
              <TextBlock Text="{Binding ProgressProcessed}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Progress.Written}" Classes="Muted" FontSize="12" />
              <TextBlock Text="{Binding ProgressWritten}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Progress.Failed}" Classes="Muted" FontSize="12" />
              <TextBlock Text="{Binding ProgressFailed}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Progress.Rate}" Classes="Muted" FontSize="12" />
              <TextBlock Text="{Binding ProgressRate}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Progress.Elapsed}" Classes="Muted" FontSize="12" />
              <TextBlock Text="{Binding ProgressElapsed}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{loc:Tr Progress.Eta}" Classes="Muted" FontSize="12" />
              <TextBlock Text="{Binding ProgressEta}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </WrapPanel>
        </Grid>

        <Button Grid.Column="1" AutomationProperties.AutomationId="CancelButton" Classes="Danger" Content="{loc:Tr Export.Cancel}"
                Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
        <Button Grid.Column="2" AutomationProperties.AutomationId="DryRunButton" Content="{loc:Tr Export.DryRun}"
                Command="{Binding DryRunCommand}" ToolTip.Tip="{loc:Tr Export.DryRun.Hint}" IsVisible="{Binding !IsRunning}" />
        <Button Grid.Column="3" AutomationProperties.AutomationId="StartButton" Classes="Primary" Content="{loc:Tr Export.Start}"
                Command="{Binding StartCommand}" />
      </Grid>
    </Border>
  </Grid>

</UserControl>

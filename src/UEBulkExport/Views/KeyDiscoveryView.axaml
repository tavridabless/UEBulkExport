<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UEBulkExport.Gui.ViewModels"
             xmlns:loc="using:UEBulkExport.Gui.Localization"
             x:Class="UEBulkExport.Gui.Views.KeyDiscoveryView"
             x:DataType="vm:KeyDiscoveryViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="28,24,28,16" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">
        <TextBlock Classes="PageTitle" Text="{loc:Tr Keys.Title}" />
        <TextBlock Classes="Hint" Text="{loc:Tr Keys.Intro}" TextWrapping="Wrap" />

        <Border Classes="Card">
          <StackPanel Spacing="8">
            <TextBlock Classes="CardTitle" Text="{loc:Tr Keys.Probe.Title}" />
            <TextBlock Classes="Hint" Text="{loc:Tr Keys.Probe.Hint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ProbeExecutablePath}" Watermark="{loc:Tr Keys.Probe.Placeholder}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseProbeExecutableCommand}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,90,*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{loc:Tr Keys.Probe.Seconds}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Minimum="1" Maximum="600" Value="{Binding ProbeListenSeconds}" />
              <TextBlock Grid.Column="2" Classes="Hint" Text="{loc:Tr Keys.Probe.NoKill}" VerticalAlignment="Center" />
              <Button Grid.Column="3" Classes="Primary" Content="{loc:Tr Keys.Probe.Start}" Command="{Binding ProbeCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="8">
            <TextBlock Classes="CardTitle" Text="{loc:Tr Keys.Source.Title}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding SourcePath}" Watermark="{loc:Tr Keys.Source.Placeholder}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseSourceCommand}" />
            </Grid>

            <TextBlock Classes="CardTitle" Text="{loc:Tr Keys.Verify.Title}" Margin="0,10,0,0" />
            <TextBlock Classes="Hint" Text="{loc:Tr Keys.Verify.Hint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding PaksPath}" Watermark="{loc:Tr Keys.Verify.Placeholder}" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFolder}" Command="{Binding BrowsePaksFolderCommand}" />
              <Button Grid.Column="2" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowsePaksFileCommand}" />
            </Grid>

            <WrapPanel Margin="0,10,0,0">
              <CheckBox IsChecked="{Binding ScanMachineCode}" Content="{loc:Tr Keys.Option.Code}" Margin="0,0,18,0" />
              <CheckBox IsChecked="{Binding VerifiedOnly}" Content="{loc:Tr Keys.Option.VerifiedOnly}" Margin="0,0,18,0" />
              <CheckBox IsChecked="{Binding ShowKeys}" Content="{loc:Tr Keys.Option.Show}" />
            </WrapPanel>
            <TextBlock Classes="Warning" Text="{loc:Tr Keys.Show.Warning}" IsVisible="{Binding ShowKeys}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="Card" IsVisible="{Binding HasError}" BorderBrush="{DynamicResource Brush.Error}">
          <StackPanel>
            <TextBlock Classes="Error" Text="{Binding ErrorHeadline}" FontWeight="SemiBold" />
            <TextBlock Classes="Hint" Text="{Binding ErrorHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="Card" IsVisible="{Binding HasResults}">
          <StackPanel Spacing="10">
            <TextBlock Classes="CardTitle" Text="{Binding SummaryText}" />
            <TextBlock Classes="Warning" Text="{loc:Tr Keys.Truncated}" IsVisible="{Binding WasTruncated}" />
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyCandidateViewModel">
                  <Border BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="Mono" Text="{Binding DisplayKey}" TextWrapping="NoWrap" />
                        <TextBlock Classes="Hint" Text="{Binding ValidationText}" />
                        <TextBlock Classes="Caption Muted" Text="{Binding Candidate.Evidence}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                        <TextBlock Classes="Caption Muted" Text="{Binding Offset}" HorizontalAlignment="Right" />
                        <TextBlock Classes="Caption Muted" Text="{Binding Confidence}" HorizontalAlignment="Right" />
                        <Button Content="{loc:Tr Keys.Use}" Command="{Binding $parent[ItemsControl].((vm:KeyDiscoveryViewModel)DataContext).UseKeyCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="ActionBar">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{loc:Tr Common.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Grid.Column="2" Classes="Primary" Content="{loc:Tr Keys.Scan}" Command="{Binding ScanCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

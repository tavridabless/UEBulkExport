<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UEBulkExport.Gui.ViewModels"
             xmlns:loc="using:UEBulkExport.Gui.Localization"
             x:Class="UEBulkExport.Gui.Views.MigrateView"
             x:DataType="vm:MigrateViewModel">

  <!--
    Rebuilding a cooked dump inside another Unreal project is a workflow of its own: a different
    source, result, tools and risk. It gets its own page and its own single action.
  -->
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0">
      <Grid Width="{Binding $parent[ScrollViewer].Viewport.Width}">
      <StackPanel Margin="28,24,28,16" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">

        <StackPanel Margin="0,0,0,4">
          <TextBlock Classes="PageTitle" Text="{loc:Tr Migrate.Title}" />
          <TextBlock Classes="PageSubtitle" Text="{loc:Tr Migrate.Subtitle}" />
        </StackPanel>

        <!-- What cannot come back: visible before anything is chosen, not hidden in a tooltip -->
        <Border Classes="Card" Padding="18,12" BorderBrush="{DynamicResource Brush.Warning}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <PathIcon Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                      Foreground="{DynamicResource Brush.Warning}"
                      Data="M12 2 L22 20 L2 20 Z M11 9 L13 9 L12.6 15 L11.4 15 Z M11 17 L13 17 L13 19 L11 19 Z" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Migrate.Limitations}" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource Brush.Text}" />
          </Grid>
        </Border>

        <!-- Source dump -->
        <Border Classes="Card">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <TextBlock Classes="CardTitle" Text="{loc:Tr Migrate.Source.Title}" />
              <Border Classes="Help" ToolTip.Tip="{loc:Tr Migrate.Source.Help}"><TextBlock /></Border>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,200" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding SourcePath}" Watermark="D:\Dump\MyGame\Content" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFolder}" Command="{Binding BrowseSourceCommand}" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding SourceVersions}" SelectedItem="{Binding SourceVersion}"
                        ToolTip.Tip="{loc:Tr Migrate.SourceVersion.Hint}" MaxDropDownHeight="360" />
            </Grid>
            <TextBlock Classes="Hint" Text="{loc:Tr Migrate.Source.Hint}" />
          </StackPanel>
        </Border>

        <!-- Target project -->
        <Border Classes="Card">
          <StackPanel>
            <TextBlock Classes="CardTitle" Text="{loc:Tr Migrate.Target.Title}" Margin="0,0,0,10" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding TargetProjectPath}" Watermark="D:\Projects\MyProject\MyProject.uproject" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseTargetProjectCommand}" />
              <Button Grid.Column="2" Content="{loc:Tr Migrate.Detect}" Command="{Binding DetectCommand}"
                      ToolTip.Tip="{loc:Tr Migrate.Detect.Hint}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,10,0,0">
              <Ellipse Classes="Dot" IsVisible="{Binding HasTargetVersion}" />
              <Ellipse Classes="Dot Idle" IsVisible="{Binding !HasTargetVersion}" />
              <TextBlock Classes="Status" Text="{Binding TargetVersionText}" />
            </StackPanel>
            <TextBlock Classes="Hint" Text="{Binding DetectionNote}"
                       IsVisible="{Binding DetectionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,8,0,0">
              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="Label" Text="{loc:Tr Migrate.Destination.Label}" />
                  <Border Classes="Help" ToolTip.Tip="{loc:Tr Migrate.Destination.Hint}" Margin="0,5,0,0"><TextBlock /></Border>
                </StackPanel>
                <TextBox Text="{Binding DestinationPath}" Watermark="/Game/Migrated" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <CheckBox IsChecked="{Binding Overwrite}" Content="{loc:Tr Migrate.Overwrite}"
                          ToolTip.Tip="{loc:Tr Migrate.Overwrite.Hint}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="Warning" Text="{Binding OverwriteWarning}" IsVisible="{Binding OverwriteWarningVisible}" />
            <TextBlock Classes="Hint" Text="{loc:Tr Migrate.Overwrite.Hint}" IsVisible="{Binding !OverwriteWarningVisible}" />
          </StackPanel>
        </Border>

        <!-- Tools: found automatically, so collapsed with their state until something is missing -->
        <Expander IsExpanded="{Binding ToolsExpanded}">
          <Expander.Header>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="CardTitle" FontSize="15" Text="{loc:Tr Migrate.Tools.Title}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="SectionState" Text="{Binding ToolsSummary}"
                         Classes.Attention="{Binding ToolsMissing}" HorizontalAlignment="Right" />
            </Grid>
          </Expander.Header>
          <StackPanel Margin="4,6,4,4">
            <TextBlock Classes="Hint" Text="{loc:Tr Migrate.Tools.Hint}" Margin="0,0,0,4" />

            <TextBlock Classes="Label" Text="{loc:Tr Migrate.UModel.Label}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding UModelPath}" Watermark="D:\Tools\umodel\umodel_64.exe" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseUModelCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding ShowUModelHelp}">
              <TextBlock Classes="Hint" Margin="0" Text="{loc:Tr Migrate.UModel.Missing}" VerticalAlignment="Center" />
              <Button Classes="Link" Content="{loc:Tr Migrate.UModel.Get}" Command="{Binding OpenUEViewerSiteCommand}"
                      FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Classes="Label" Text="{loc:Tr Migrate.Editor.Label}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding UnrealEditorPath}" Watermark="C:\Program Files\Epic Games\UE_5.x\Engine\Binaries\Win64\UnrealEditor-Cmd.exe" />
              <Button Grid.Column="1" Content="{loc:Tr Common.BrowseFile}" Command="{Binding BrowseUnrealEditorCommand}" />
            </Grid>
            <TextBlock Classes="Hint" Text="{loc:Tr Migrate.Editor.Hint}" />
          </StackPanel>
        </Expander>

        <!-- Outcome: error, or a UE Viewer failure waiting for a decision -->
        <Border x:Name="ErrorCard" Classes="Card" IsVisible="{Binding HasError}" BorderBrush="{DynamicResource Brush.Error}">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Error.Title}" Classes="Muted" FontSize="12" />
            <TextBlock Text="{Binding ErrorHeadline}" Classes="Error" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding ErrorHint}" Classes="Mono" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasPendingIssue}">
              <Button Classes="Primary" Content="{loc:Tr Migrate.Error.Continue}" Command="{Binding ContinueCommand}" />
              <TextBlock Classes="Hint" Margin="4,0,0,0" VerticalAlignment="Center" Text="{loc:Tr Migrate.Error.ContinueHint}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Outcome: summary -->
        <Border x:Name="SummaryCard" Classes="Card" IsVisible="{Binding HasSummary}">
          <StackPanel>
            <TextBlock Classes="CardTitle" Text="{Binding SummaryTitle}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Summary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SummaryLine">
                  <Grid ColumnDefinitions="260,*" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="Muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,14,0,0">
              <Button Content="{loc:Tr Migrate.OpenContent}" Command="{Binding OpenContentCommand}"
                      IsVisible="{Binding CanOpenContent}" Margin="0,0,8,8" />
              <Button Content="{loc:Tr Migrate.OpenReport}" Command="{Binding OpenReportCommand}"
                      IsVisible="{Binding HasReport}" Margin="0,0,8,8" />
              <Button Content="{loc:Tr Migrate.OpenLog}" Command="{Binding OpenLogCommand}"
                      IsVisible="{Binding HasImportLog}" Margin="0,0,8,8" />
              <Button Content="{loc:Tr Migrate.OpenWorking}" Command="{Binding OpenWorkingDirectoryCommand}"
                      IsVisible="{Binding HasWorkingDirectory}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

      </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Action bar -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,1,0,0" Padding="28,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center"
              IsVisible="{Binding ShowReadiness}">
          <Panel Grid.Column="0">
            <Ellipse Classes="Dot Error" IsVisible="{Binding IsReadinessBlocked}" />
            <Ellipse Classes="Dot Warning" IsVisible="{Binding IsReadinessWarning}" />
            <Ellipse Classes="Dot" IsVisible="{Binding IsReadinessOk}" />
          </Panel>
          <TextBlock Grid.Column="1" Classes="Status" Text="{Binding ReadinessText}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadinessText}" />
        </Grid>

        <Grid Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"
              RowDefinitions="Auto,Auto" RowSpacing="6">
          <ProgressBar Grid.Row="0" Value="{Binding Progress}" Maximum="1" />
          <TextBlock Grid.Row="1" Text="{Binding Stage}" FontSize="12" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.Text}" />
        </Grid>

        <Button Grid.Column="1" Classes="Danger" Content="{loc:Tr Export.Cancel}" Command="{Binding CancelCommand}"
                IsVisible="{Binding IsBusy}" />
        <Button Grid.Column="2" Classes="Primary" Content="{loc:Tr Migrate.Start}" Command="{Binding StartCommand}" />
      </Grid>
    </Border>
  </Grid>

</UserControl>

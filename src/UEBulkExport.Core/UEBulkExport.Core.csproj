<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>UEBulkExport.Core</AssemblyName>
    <RootNamespace>UEBulkExport</RootNamespace>
    <Description>Bulk export of an entire Unreal Engine container (.utoc/.ucas/.pak) into one folder: the engine shared by the CLI and the GUI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" />
    <PackageReference Include="CUE4Parse-Conversion" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UEBulkExport.Tests" />
  </ItemGroup>

</Project>
